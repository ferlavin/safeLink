# local | production (en production JWT_SECRET y ADMIN_PASSWORD no pueden ser los defaults)
ENV=development

# Conexion a PostgreSQL. Con docker compose: user/pass/db safelink (solo local).
# No uses estas credenciales en produccion.
DATABASE_URL=postgresql+psycopg2://safelink:safelink@localhost:5432/safelink

# Seguridad JWT. En production usa un secreto largo y unico.
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Origen(es) permitidos para CORS. Separar por comas. Lista explicita, sin wildcards.
# Produccion: tu dominio Vercel, ej. https://safelink.vercel.app
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:5174

# ID de la extension Chrome (chrome://extensions, o el popup de SafeLink).
# CORS de Fase 2 no acepta chrome-extension://*. Sin este valor, el login
# del popup y /analysis/check pueden fallar el preflight. Varios IDs: coma.
CHROME_EXTENSION_ID=

# Usuario administrador inicial (se crea automaticamente al arrancar).
# En production no uses admin1234.
ADMIN_EMAIL=admin@safelink.app
ADMIN_PASSWORD=admin1234

# Opcional: Google Safe Browsing
GOOGLE_SAFE_BROWSING_API_KEY=
